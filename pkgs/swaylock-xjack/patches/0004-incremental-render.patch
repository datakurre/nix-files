+static void xjack_draw_chars(struct xjack_state *xj, cairo_t *cr,
+		int start, int end, int bottom) {
+	cairo_select_font_face(cr, xj->font,
+		CAIRO_FONT_SLANT_NORMAL, CAIRO_FONT_WEIGHT_NORMAL);
+	cairo_set_font_size(cr, xj->font_size * xj->scale);
+	cairo_set_source_rgba(cr, xj->r, xj->g, xj->b, xj->opacity);
+
+	for (int i = start; i < end; ) {
+		struct xjack_char *ch = &xj->chars[i];
+
+		if (ch->py < -xj->line_height || ch->py > bottom) {
+			i++;
+			continue;
+		}
+
+		int run_len = 1;
+		while (i + run_len < end) {
+			struct xjack_char *next = &xj->chars[i + run_len];
+			if (next->py != ch->py)
+				break;
+			if (next->px != ch->px + run_len * xj->char_width)
+				break;
+			run_len++;
+		}
+
+		char buf[513];
+		int buf_len = run_len < 512 ? run_len : 512;
+		for (int k = 0; k < buf_len; k++) {
+			buf[k] = xj->chars[i + k].c;
+		}
+		buf[buf_len] = '\0';
+
+		cairo_save(cr);
+		cairo_set_operator(cr, CAIRO_OPERATOR_SOURCE);
+		cairo_set_source_rgb(cr, xj->bg_r, xj->bg_g, xj->bg_b);
+		cairo_rectangle(cr, ch->px, ch->py - xj->ascent,
+			run_len * xj->char_width, xj->line_height);
+		cairo_fill(cr);
+		cairo_restore(cr);
+
+		cairo_move_to(cr, (double)ch->px, (double)ch->py);
+		cairo_show_text(cr, buf);
+		{
+			int line_right = xj->hspace
+				+ (xj->columns + 1) * xj->char_width;
+			int clear_x = ch->px + run_len * xj->char_width;
+			if (clear_x < line_right) {
+				cairo_save(cr);
+				cairo_set_operator(cr, CAIRO_OPERATOR_SOURCE);
+				cairo_set_source_rgb(cr, xj->bg_r, xj->bg_g, xj->bg_b);
+				cairo_rectangle(cr, clear_x, ch->py - xj->ascent,
+					line_right - clear_x, xj->line_height);
+				cairo_fill(cr);
+				cairo_restore(cr);
+			}
+		}
+
+		i += buf_len;
+	}
+}
+
