+		cairo_paint(tc);
 
-	int bottom = h + xj->line_height;
+		cairo_set_source_rgb(tc, xj->bg_r, xj->bg_g, xj->bg_b);
+		cairo_rectangle(tc, 0, h - inc, w, inc);
+		cairo_fill(tc);
 
-	for (int i = 0; i < xj->char_count; ) {
-		struct xjack_char *ch = &xj->chars[i];
+		cairo_destroy(tc);
 
-		if (ch->py < -xj->line_height || ch->py > bottom) {
-			i++;
-			continue;
-		}
+		cairo_surface_destroy(xj->accum_surface);
+		xj->accum_surface = tmp;
+	}
 
-		int run_len = 1;
-		while (i + run_len < xj->char_count) {
-			struct xjack_char *next = &xj->chars[i + run_len];
-			if (next->py != ch->py)
-				break;
-			if (next->px != ch->px + run_len * xj->char_width)
-				break;
-			run_len++;
-		}
+	if (xj->first_paint) {
+		cairo_t *ac = cairo_create(xj->accum_surface);
 
-		char buf[512];
-		int buf_len = run_len < 512 ? run_len : 512;
-		for (int k = 0; k < buf_len; k++) {
-			buf[k] = xj->chars[i + k].c;
-		}
+		cairo_set_operator(ac, CAIRO_OPERATOR_SOURCE);
+		cairo_set_source_rgb(ac, xj->bg_r, xj->bg_g, xj->bg_b);
+		cairo_paint(ac);
 
-		cairo_move_to(cairo, (double)ch->px, (double)ch->py);
-		cairo_show_text(cairo, buf);
+		xjack_draw_chars(xj, ac, 0, xj->char_count, bottom);
 
-		i += buf_len;
+		cairo_destroy(ac);
+		xj->accum_char_count = xj->char_count;
+		xj->first_paint = false;
+	} else if (xj->accum_char_count < xj->char_count) {
+		cairo_t *ac = cairo_create(xj->accum_surface);
+
+		xjack_draw_chars(xj, ac, xj->accum_char_count,
+			xj->char_count, bottom);
+
+		cairo_destroy(ac);
+		xj->accum_char_count = xj->char_count;
 	}
 
-	cairo_restore(cairo);
+	cairo_set_operator(cairo, CAIRO_OPERATOR_SOURCE);
+	cairo_set_source_surface(cairo, xj->accum_surface, 0, 0);
+	cairo_paint(cairo);
 }
 
