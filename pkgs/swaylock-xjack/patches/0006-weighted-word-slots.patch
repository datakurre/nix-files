+static const char *xjack_weighted_pick(struct xjack_word_slot *slot,
+		unsigned long *rng_state) {
+	if (slot->num_choices == 0)
+		return "";
+	double r = xjack_frand(rng_state) * slot->total_weight;
+	for (int i = 0; i < slot->num_choices; i++) {
+		if (r < slot->choices[i].cum_weight)
+			return slot->choices[i].word;
+	}
+	return slot->choices[slot->num_choices - 1].word;
+}
+
+static void xjack_tokenize_source(struct xjack_state *xj,
+		struct swaylock_state *state) {
+	xj->num_slots = state->args.xjack_word_defs_count;
+	xj->slots = calloc((size_t)xj->num_slots, sizeof(struct xjack_word_slot));
+
+	for (int i = 0; i < xj->num_slots; i++) {
+		const char *def = state->args.xjack_word_defs[i];
+		const char *colon = strchr(def, ':');
+		if (!colon) continue;
+
+		int nlen = (int)(colon - def);
+		char name[256];
+		if (nlen >= 255) nlen = 255;
+		snprintf(name, sizeof(name), "%.*s", nlen, def);
+		xj->slots[i].name = strdup(name);
+
+		const char *c = colon + 1;
+		int max_choices = 64;
+		xj->slots[i].choices = calloc((size_t)max_choices,
+			sizeof(struct xjack_word_choice));
+		xj->slots[i].num_choices = 0;
+		xj->slots[i].total_weight = 0;
+
+		while (*c) {
+			while (*c == ' ') c++;
+			if (!*c) break;
+
+			const char *eq = strchr(c, '=');
+			const char *comma = strchr(c, ',');
+			if (!comma && *c) comma = c + strlen(c);
+
+			if (eq && eq < comma) {
+				int wlen = (int)(eq - c);
+				double wgt = strtod(eq + 1, NULL);
+
+				char word[256];
+				if (wlen >= 255) wlen = 255;
+				snprintf(word, sizeof(word), "%.*s", wlen, c);
+
+				int ci = xj->slots[i].num_choices;
+				if (ci >= max_choices - 1) break;
+				xj->slots[i].choices[ci].word = strdup(word);
+				xj->slots[i].choices[ci].weight = wgt;
+				xj->slots[i].total_weight += wgt;
+				xj->slots[i].choices[ci].cum_weight =
+					xj->slots[i].total_weight;
+				xj->slots[i].num_choices++;
+			}
+
+			c = *comma ? comma + 1 : comma;
+		}
+	}
+
+	int max_tokens = 64;
+	xj->tokens = calloc((size_t)max_tokens, sizeof(struct xjack_token));
+	xj->num_tokens = 0;
+
+	const char *p = xj->s_source;
+
+	while (*p) {
+		if (*p == '{') {
+			const char *end = p + 1;
+			while (*end && *end != '}')
+				end++;
+			if (*end == '}' && end > p + 1) {
+				int slen = (int)(end - p - 1);
+				char sname[256];
+				if (slen >= 255) slen = 255;
+				snprintf(sname, sizeof(sname), "%.*s", slen, p + 1);
+
+				int slot_id = -1;
+				for (int i = 0; i < xj->num_slots; i++) {
+					if (strcmp(xj->slots[i].name, sname) == 0) {
+						slot_id = i;
+						break;
+					}
+				}
+
+				if (slot_id >= 0) {
+					struct xjack_token *t = &xj->tokens[xj->num_tokens++];
+					t->is_slot = 1;
+					t->slot_id = slot_id;
+					t->text = NULL;
+				} else {
+					int full = (int)(end - p + 1);
+					char *lit = malloc((size_t)full + 1);
+					snprintf(lit, (size_t)full + 1, "%.*s", full, p);
+					struct xjack_token *t = &xj->tokens[xj->num_tokens++];
+					t->is_slot = 0;
+					t->text = lit;
+				}
+				p = end + 1;
+				continue;
+			}
+		}
+
+		const char *start = p;
+		while (*p && *p != '{')
+			p++;
+		if (p > start) {
+			int len = (int)(p - start);
+			char *lit = malloc((size_t)len + 1);
+			snprintf(lit, (size_t)len + 1, "%.*s", len, start);
+			struct xjack_token *t = &xj->tokens[xj->num_tokens++];
+			t->is_slot = 0;
+			t->text = lit;
+		}
+	}
+}
+
+static void xjack_resolve_source(struct xjack_state *xj) {
+	free(xj->rendered_source);
+
+	char buf[4096];
+	int pos = 0;
+
+	for (int i = 0; i < xj->num_tokens; i++) {
+		if (xj->tokens[i].is_slot) {
+			struct xjack_word_slot *slot =
+				&xj->slots[xj->tokens[i].slot_id];
+			const char *word = xjack_weighted_pick(slot,
+				&xj->rng_state);
+			int wlen = (int)strlen(word);
+			if (pos + wlen < 4095) {
+				memcpy(buf + pos, word, (size_t)wlen);
+				pos += wlen;
+			}
+		} else {
+			int tlen = (int)strlen(xj->tokens[i].text);
+			if (pos + tlen < 4095) {
+				memcpy(buf + pos, xj->tokens[i].text, (size_t)tlen);
+				pos += tlen;
+			}
+		}
+	}
+	buf[pos] = '\0';
+	xj->rendered_source = strdup(buf);
+}
+
 static void xjack_resize(struct swaylock_state *state, int width, int height) {
 	(void)width;
 	(void)height;


